{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/porthole",
    "name": "Porthole",
    "sourceRepository": "https://github.com/just-every/run-porthole",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm exec rer install",
      "build": "pnpm run build",
      "verify": "pnpm run verify && pnpm exec rer check --profile first-party && pnpm check:deployment-spec",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow OPERATIONS.md: stop writes and scheduled work, retain the exact source and private configuration, export the installation with rer export, restore into fresh empty resources with rer import, establish a fresh owner, and compare a real re-export before routing traffic. Preserve applied migration names and bytes."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@86c8b37399c901bffd9a240dbd1148a65ec83b34",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_ORIGIN",
        "AUTH_LOCAL",
        "IDENTITY_PROVIDER",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID",
        "OWNER_EMAIL"
      ],
      "secretNames": [
        "SESSION_SECRET",
        "SETUP_TOKEN",
        "INSTALLATION_KEY"
      ],
      "optionalSecretNames": [
        "MAIL_API_KEY",
        "ANALYTICS_PRIMARY_TOKEN",
        "ANALYTICS_STANDBY_TOKEN",
        "INSTALLATION_KEY_PREVIOUS"
      ],
      "providerEffects": [
        "outbound-mail"
      ],
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      },
      "surfaces": {
        "app": {
          "path": "/signin",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false
          }
        }
      },
      "recovery": "Retain an installation export and exact source before migration. Restore into empty resources; establish fresh owner authority and verify native data before resuming work."
    }
  },
  "edition": {
    "manifestFile": "edition.json",
    "componentId": "just-every/porthole"
  }
}
