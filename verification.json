{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party",
        "node scripts/porthole/public-schema.mjs --check",
        "node scripts/porthole/contract-docs.mjs check PORT-075"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "pnpm run typecheck",
        "pnpm run test:typecheck",
        "PORTHOLE_NATIVE_ERASURE_ONLY=1 node tests/porthole/native-archive.mjs"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "PORTHOLE_CORE_ONLY=1 pnpm run test:runtime"
      ]
    },
    {
      "name": "exports",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "python3 -m venv .cache/export-readers && .cache/export-readers/bin/pip install --disable-pip-version-check -r tests/porthole/export-readers.txt",
        "PORTHOLE_ERASURE_ONLY=1 pnpm run test:runtime",
        "PORTHOLE_EXPORT_ONLY=1 pnpm run test:runtime"
      ]
    },
    {
      "name": "ingest",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "PORTHOLE_INGEST_ONLY=1 pnpm run test:runtime",
        "PORTHOLE_METRIC_RULES_ONLY=1 pnpm run test:runtime"
      ]
    },
    {
      "name": "traces",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "PORTHOLE_TRACE_ONLY=1 pnpm run test:runtime"
      ]
    },
    {
      "name": "analytical",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "PORTHOLE_ANALYTICAL_ONLY=1 pnpm run test:runtime"
      ]
    },
    {
      "name": "migration",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "PORTHOLE_MIGRATION_ONLY=1 pnpm run test:runtime"
      ]
    },
    {
      "name": "dashboards",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "PORTHOLE_DASHBOARD_ONLY=1 pnpm run test:runtime",
        "pnpm exec rer build --site",
        "PORTHOLE_API_ONLY=1 pnpm run test:runtime"
      ]
    },
    {
      "name": "mail-receipts",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "PORTHOLE_MAIL_ONLY=1 PORTHOLE_MAIL_PROVIDER=resend node tests/runtime.mjs"
      ]
    },
    {
      "name": "follow-up",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "PORTHOLE_FOLLOW_UP_ONLY=1 pnpm run test:runtime",
        "PORTHOLE_SLO_ONLY=1 pnpm run test:runtime",
        "PORTHOLE_NOTEBOOKS_ONLY=1 pnpm run test:runtime"
      ]
    }
  ],
  "nightly": []
}
