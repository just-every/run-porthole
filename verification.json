{
  "push": [
    {
      "name": "source",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run check --profile first-party"
      ]
    },
    {
      "name": "typecheck",
      "browser": false,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "pnpm run typecheck",
        "pnpm run test:typecheck"
      ]
    },
    {
      "name": "runtime",
      "browser": true,
      "hosted": true,
      "commands": [
        "pnpm run build",
        "PORTHOLE_CORE_ONLY=1 pnpm run test:runtime"
      ]
    },
    {
      "name": "ingest",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "PORTHOLE_INGEST_ONLY=1 pnpm run test:runtime"
      ]
    },
    {
      "name": "traces",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "PORTHOLE_TRACE_ONLY=1 pnpm run test:runtime"
      ]
    },
    {
      "name": "analytical",
      "browser": true,
      "hosted": false,
      "commands": [
        "pnpm run build",
        "PORTHOLE_ANALYTICAL_ONLY=1 pnpm run test:runtime"
      ]
    }
  ],
  "nightly": []
}
